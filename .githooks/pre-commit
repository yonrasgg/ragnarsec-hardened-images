#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export PYTHONDONTWRITEBYTECODE=1
python3 -m unittest discover -s tests -p test_public*.py
python3 tools/publication_guard.py .
task_scanner=${GITLEAKS_BIN:-gitleaks}
if ! command -v "$task_scanner" >/dev/null 2>&1; then
  printf '%s\n' 'STOP: install a verified Gitleaks binary or set GITLEAKS_BIN.' >&2
  exit 2
fi
task_scan_config=$(mktemp)
trap 'rm -f "$task_scan_config"' EXIT
printf '[extend]\nuseDefault = true\n' > "$task_scan_config"
"$task_scanner" git . --pre-commit --staged --config "$task_scan_config" \
  --gitleaks-ignore-path "$task_scan_config.absent" --ignore-gitleaks-allow \
  --redact=100 --no-banner
