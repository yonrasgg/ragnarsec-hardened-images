{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["development"],
  "extends": [
    "config:best-practices",
    ":docker",
    "docker:enableMajor",
    ":semanticCommits",
    ":pinDigests"
  ],
  "labels": [
    "dependencies",
    "security"
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "timezone": "Etc/UTC",
  "regexManagers": [],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine",
        "postgres",
        "ghcr.io/yonrasgg/ragnarsec-base",
        "ghcr.io/yonrasgg/ragnarsec-python-base"
      ],
      "versioning": "docker"
    },
    {
      "description": "Automerge non-major updates if CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
